# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS (shared credentials come from the EC2 IAM Role in production;
# for local development you may set them here instead)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB Table Names
DDB_TABLE_USERS=FoodShare_Users
DDB_TABLE_DONATIONS=FoodShare_Donations

# S3
S3_BUCKET_NAME=foodshare-food-images

# SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:FoodShareNotifications

# CloudWatch Logs
CW_LOG_GROUP=/foodshare/backend
CW_LOG_STREAM=app-logs

# CORS
CLIENT_ORIGIN=http://localhost:5173
